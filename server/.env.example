PORT=4000
JWT_SECRET=troque-por-um-valor-aleatorio-e-forte-em-producao

# Busca de músicas do Spotify (pra "música do perfil"). Crie um app grátis em
# https://developer.spotify.com/dashboard -> Create app -> copie o Client ID e o
# Client Secret aqui embaixo. Sem isso, a busca de músicas fica desabilitada
# (o app ainda funciona normalmente, só essa funcionalidade específica que some).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Verificação de email ───────────────────────────────────────────────
# Sem isso, o código de verificação aparece no console do servidor (modo dev)
# e o app continua funcionando normalmente. Preencha quando quiser enviar de verdade.
#
# Gmail: ative a verificação em 2 etapas e gere uma "Senha de app" em
#        https://myaccount.google.com/apppasswords — use ela em SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seuemail@gmail.com
#   SMTP_PASS=a-senha-de-app-de-16-letras
#
# Resend: crie a chave em https://resend.com/api-keys
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_sua_chave_aqui
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SafeCord <nao-responda@safecord.app>

# ─── Pagamentos (Stripe, modo teste) ────────────────────────────────────
# Pegue a chave secreta de TESTE em https://dashboard.stripe.com/test/apikeys
# (começa com sk_test_). Sem ela, a loja aparece mas o botão de comprar avisa
# que os pagamentos não estão configurados — nada é cobrado.
# No modo teste, use o cartão 4242 4242 4242 4242, validade futura e CVC 123.
# ─── Pagamentos: Mercado Pago (principal) ───────────────────────────────────
# Access Token da sua aplicação no painel de desenvolvedores do Mercado Pago
# (Suas integrações → sua aplicação → Credenciais). Para testar use as credenciais
# de TESTE (começam com TEST-); em produção, as de produção (APP_USR-...).
MERCADOPAGO_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações → Webhooks → Configurar notificações).
# URL do webhook: https://SEU-DOMINIO/api/payments/mercadopago/webhook  (evento: Pagamentos)
MERCADOPAGO_WEBHOOK_SECRET=
# O webhook e a volta automática só funcionam com APP_URL pública em https.
# Sem isso, o app confirma o pagamento quando a pessoa clica em "Já paguei".

# ─── Stripe (opcional, alternativa) — só é usado se o Mercado Pago não estiver configurado
STRIPE_SECRET_KEY=
# Opcional: só se você configurar um webhook em https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=
# Pra onde o Stripe volta depois do pagamento (deixe assim em desenvolvimento)
APP_URL=http://localhost:4000

# ─── Mercado (lojas dos usuários) ───────────────────────────────────────────
# Taxa do SafeCord sobre cada venda (em %, sobre o valor dos produtos, sem o frete)
MARKET_FEE_PERCENT=10
# Emails (separados por vírgula) que veem o painel de repasses do Mercado.
# O email precisa estar verificado na conta.
ADMIN_EMAILS=
# Só pra testar a loja localmente SEM Stripe: 1 = mostra um botão "pagar (teste)".
# Ignorado quando STRIPE_SECRET_KEY está configurada. Nunca use em produção.
MARKET_DEV_PAYMENTS=0

# ─── Verificação de vendedores (documento, selfie, dados bancários) ─────────
# Chave que criptografa CPF, endereço, conta bancária e as fotos de documento/rosto.
# OBRIGATÓRIA em produção. Gere uma vez e guarde num lugar seguro — se perder, os dados
# já salvos não podem mais ser lidos:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
