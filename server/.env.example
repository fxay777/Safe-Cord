PORT=4000
JWT_SECRET=troque-por-um-valor-aleatorio-e-forte-em-producao

# Busca de músicas do Spotify (pra "música do perfil"). Crie um app grátis em
# https://developer.spotify.com/dashboard -> Create app -> copie o Client ID e o
# Client Secret aqui embaixo. Sem isso, a busca de músicas fica desabilitada
# (o app ainda funciona normalmente, só essa funcionalidade específica que some).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Verificação de email ───────────────────────────────────────────────
# Sem isso, o código de verificação aparece no console do servidor (modo dev)
# e o app continua funcionando normalmente. Preencha quando quiser enviar de verdade.
#
# Gmail: ative a verificação em 2 etapas e gere uma "Senha de app" em
#        https://myaccount.google.com/apppasswords — use ela em SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=seuemail@gmail.com
#   SMTP_PASS=a-senha-de-app-de-16-letras
#
# Resend: crie a chave em https://resend.com/api-keys
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_sua_chave_aqui
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SafeCord <nao-responda@safecord.app>

# ─── Pagamentos (Stripe, modo teste) ────────────────────────────────────
# Pegue a chave secreta de TESTE em https://dashboard.stripe.com/test/apikeys
# (começa com sk_test_). Sem ela, a loja aparece mas o botão de comprar avisa
# que os pagamentos não estão configurados — nada é cobrado.
# No modo teste, use o cartão 4242 4242 4242 4242, validade futura e CVC 123.
STRIPE_SECRET_KEY=
# Opcional: só se você configurar um webhook em https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=
# Pra onde o Stripe volta depois do pagamento (deixe assim em desenvolvimento)
APP_URL=http://localhost:4000
